{
    "version": 3,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 25,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "default",
            "displayName": "Default (Debug)",
            "binaryDir": "${sourceDir}/build",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
            }
        },
        {
            "name": "release",
            "displayName": "Release",
            "binaryDir": "${sourceDir}/build-release",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
            }
        },
        {
            "name": "clang",
            "displayName": "Clang (Debug) - second compiler",
            "binaryDir": "${sourceDir}/build-clang",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
                "CMAKE_CXX_COMPILER": "clang++"
            }
        },
        {
            "name": "asan",
            "displayName": "ASan/UBSan (Debug)",
            "binaryDir": "${sourceDir}/build-asan",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_CXX_FLAGS": "-fsanitize=address,undefined -fno-omit-frame-pointer -g -O1",
                "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=address,undefined"
            }
        },
        {
            "name": "tsan",
            "displayName": "TSan (Debug)",
            "binaryDir": "${sourceDir}/build-tsan",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_CXX_FLAGS": "-fsanitize=thread -fno-omit-frame-pointer -g -O1",
                "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=thread"
            }
        }
    ],
    "buildPresets": [
        { "name": "default", "configurePreset": "default", "configuration": "Debug" },
        { "name": "release", "configurePreset": "release", "configuration": "Release" },
        { "name": "clang",   "configurePreset": "clang",   "configuration": "Debug" },
        { "name": "asan",    "configurePreset": "asan",    "configuration": "Debug" },
        { "name": "tsan",    "configurePreset": "tsan",    "configuration": "Debug" }
    ],
    "testPresets": [
        { "name": "default", "configurePreset": "default", "configuration": "Debug",   "output": { "outputOnFailure": true } },
        { "name": "release", "configurePreset": "release", "configuration": "Release", "output": { "outputOnFailure": true } },
        { "name": "clang",   "configurePreset": "clang",   "configuration": "Debug",   "output": { "outputOnFailure": true } },
        { "name": "asan",    "configurePreset": "asan",    "configuration": "Debug",   "output": { "outputOnFailure": true } },
        { "name": "tsan",    "configurePreset": "tsan",    "configuration": "Debug",   "output": { "outputOnFailure": true } }
    ]
}
