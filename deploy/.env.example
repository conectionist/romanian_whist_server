# Settings for the compose files in this folder. Copy this file to .env beside the compose file you
# use, and change what applies to it.

# docker-compose.yml only, and required: the address the page is served on. A domain name that
# points at this machine gets HTTPS by itself; :80 serves plain HTTP, for a trial.
WHIST_DOMAIN=

# Both compose files: the images to run. Pin both in production, and pick tags whose protocol
# labels (io.github.conectionist.whist.protocol) are equal.
#WHIST_SERVER_TAG=latest
#WHIST_WEB_TAG=latest

# docker-compose.own-proxy.yml only: where the server listens on this machine. It speaks plain HTTP,
# so use 0.0.0.0:8080 only when the proxy is on another host and the network between is private.
#WHIST_LISTEN=127.0.0.1:8080

# docker-compose.override.yml for a proxy in a container (see the README): the Docker network the
# proxy is on.
#WHIST_PROXY_NETWORK=
