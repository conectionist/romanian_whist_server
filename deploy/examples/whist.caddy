# Romanian Whist behind your own Caddy: import this inside the site block for its host.
# Everything goes to the server, /health and /version included. Caddy passes the WebSocket at /ws
# through by itself, and sends X-Forwarded-For, which the server needs to tell its clients apart.
# The server sends the page's security headers and its caching rules itself, so none are added here.
reverse_proxy 127.0.0.1:8080
